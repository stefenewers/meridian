# Meridian runs entirely locally with no third-party credentials. These only exist so the
# UI and the simulation service can find each other when ports change.

# Where the Next.js app should reach the FastAPI simulation service.
NEXT_PUBLIC_MERIDIAN_API=http://127.0.0.1:8000

# Host/port for the simulation service itself.
MERIDIAN_API_HOST=127.0.0.1
MERIDIAN_API_PORT=8000
